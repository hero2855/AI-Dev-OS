{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "agent-core/**/*.ts",
    "skill-system/**/*.ts",
    "workspace/**/*.ts",
    "tests/**/*.ts"
  ]
}
